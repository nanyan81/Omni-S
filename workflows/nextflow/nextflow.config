/*
 * Omni-S Nextflow 基础配置模板
 */

params {
    run_id     = "run_dev_001"
    dataset_id = null
    input_dir  = null
    outdir     = "./runs/${params.run_id}"
}

docker {
    enabled = true
}

profiles {
    local {
        process.executor = 'local'
    }
    // 未来集群扩展：取消注释并按服务器实际队列配置
    // slurm {
    //     process.executor = 'slurm'
    // }
}
